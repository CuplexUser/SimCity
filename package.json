{
  "name": "webcity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "gen:atlas": "node tools/genStarterAtlas.mjs",
    "build:atlas": "node tools/genCars.mjs && node tools/buildAtlas.mjs",
    "gen:cars": "node tools/genCars.mjs",
    "gen:cars:blender": "blender -b -P tools/blender/render_cars.py -- --out tools/assets-src",
    "gen:city:blend": "blender -b -P tools/blender/build_city_assets.py",
    "render:city": "blender -b tools/blender/city_assets.blend -P tools/blender/render_isos.py -- --out tools/assets-src"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "pixi.js": "^8.23.0",
    "preact": "^10.29.8",
    "simplex-noise": "^4.0.3",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^25.9.9",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@11.5.2"
}
